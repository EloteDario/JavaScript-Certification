const forumLatest =
  'https://cdn.freecodecamp.org/curriculum/forum-latest/latest.json';
const forumTopicUrl = 'https://forum.freecodecamp.org/t/';
const forumCategoryUrl = 'https://forum.freecodecamp.org/c/';
const avatarUrl = 'https://cdn.freecodecamp.org/curriculum/forum-latest';

const allCategories = {
  299: { category: 'Career Advice', className: 'career' },
  409: { category: 'Project Feedback', className: 'feedback' },
  417: { category: 'freeCodeCamp Support', className: 'support' },
  421: { category: 'JavaScript', className: 'javascript' },
  423: { category: 'HTML - CSS', className: 'html-css' },
  424: { category: 'Python', className: 'python' },
  432: { category: 'You Can Do This!', className: 'motivation' },
  560: { category: 'Back-End Development', className: 'backend' }
};

function timeAgo(releasedAt) {  
const fechaISOAct = new Date()

const diffMs = fechaISOAct - Date.parse(releasedAt)

const diffMinutes = Math.floor(diffMs/(1000 * 60))
const diffHours = Math.floor(diffMs/(1000 * 60 * 60))
const diffDays = Math.floor(diffMs/(1000 * 60 * 60 * 24))
 
if (diffMinutes < 60) {
  return `${diffMinutes}m ago`
} else if (diffHours < 24) {
  return `${diffHours}h ago` 
} else {
  return `${diffDays}d ago` 
}

}



function viewCount(views) {
  if (views >= 1000) {
    return `${Math.floor(views/1000)}k`
  } else {
    return views
  }
}


function forumCategory(categoryId) {

  if (allCategories[categoryId] !== undefined) {
    
    return `<a class="category ${allCategories[categoryId]["className"]}" href="${forumCategoryUrl}${allCategories[categoryId]["className"]}/${categoryId}">${allCategories[categoryId]["category"]}</a>`


  } else {
    return `<a class="category general" href="${forumCategoryUrl}general/${categoryId}">General</a>`
  }



}

function avatars(posters , users) {
  let stringImgs = `` 
  const listPostsId = []

  for (let i = 0; i < posters.length; i++) {
    listPostsId.push(posters[i].user_id)
  }

  for (let o = 0; o < listPostsId.length; o++) {
    for (let m = 0; m < users.length; m++) {
      if (listPostsId[o] === users[m]["id"]) {
        if (!users[m]["avatar_template"].replace('{size}', '30')[0] === "/") {
        stringImgs += `<img src="${users[m]["avatar_template"].replace('{size}', '30')}" alt="${users[m]["name"]}">`}
        else {
          stringImgs += `<img src="${avatarUrl + users[m]["avatar_template"].replace('{size}', '30')}" alt="${users[m]["name"]}">`
        }
      }
    }
  }
  return stringImgs // high quality code 
}

function showLatestPosts(forumLatest) {
  const users = forumLatest.users
  const topicList = forumLatest.topic_list

  const postsContainer = document.querySelector("#posts-container")
  let htmlString = "";
  for (let i = 0; i < topicList.topics.length; i++) {
    const {id, title, views, posts_count, slug, posters, category_id, bumped_at} = topicList.topics[i]
    htmlString += `<tr>
    <td>
    <a class="post-title" href="${forumTopicUrl}${slug}/${id}">${title}</a>
    ${forumCategory(category_id)}
    </td>
    <td>
      <div class="avatar-container">
        ${avatars(posters, users)}
      </div>
    </td>
    <td>${posts_count - 1}</td>
    <td>${viewCount(views)}</td>
    <td>${timeAgo(bumped_at)}</td>
    </tr>`
  }
  
  postsContainer.innerHTML = htmlString;
}
 

async function fetchData() {
  try {
    const respuesta = await fetch(forumLatest)
    
    const parseArepa = await respuesta.json()
    showLatestPosts(parseArepa)
  } catch (error) {
    console.log(error)
  }
}
