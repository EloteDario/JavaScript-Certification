function timeAgo(releasedAt) {  

  const minute = releasedAt.slice(14, 16)
  const hour = releasedAt.slice(11, 13)
  const day = releasedAt.slice(8, 10)
  const month = releasedAt.slice(5, 7)
  const year = releasedAt.slice(0, 4)

  const fechaISOAct = new Date().toISOString();

  const actMinute = fechaISOAct.slice(14, 16)
  const actHour = fechaISOAct.slice(11, 13)
  const actDay = fechaISOAct.slice(8, 10)
  const actMonth = fechaISOAct.slice(5, 7)
  const actYear = fechaISOAct.slice(0, 4)


  const minutesAgo = actMinute - minute
  const hoursAgo = actHour - hour
  const daysAgo = actDay - day
  const monthsAgo = actMonth - month
  const yearsAgo = actYear - year
